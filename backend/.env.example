# ================================================================
# DRISHTI-X — Backend Environment Variables
# ================================================================
# For LOCAL development: copy to backend/.env and fill in values.
# For RENDER production: add each variable in the Render dashboard
# under Environment > Environment Variables. Do NOT commit .env.
# ================================================================

# ── Application ─────────────────────────────────────────────────
APP_ENV=production
DEBUG=False

# ── Security ────────────────────────────────────────────────────
# REQUIRED — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_REAL_SECRET_KEY_32_BYTES_HEX

# ── Database ────────────────────────────────────────────────────
# REQUIRED — Render PostgreSQL internal connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# On Render: copy from your PostgreSQL service → Internal Database URL
DATABASE_URL=postgresql://user:password@host:5432/drishti_x

# ── CORS ────────────────────────────────────────────────────────
# REQUIRED in production — your deployed frontend URL
# Multiple origins: comma-separated
#   FRONTEND_URL=https://drishti-x.vercel.app,https://www.drishti-x.com
FRONTEND_URL=https://your-frontend.vercel.app

# ── Model files ─────────────────────────────────────────────────
# Path to model weights directory.
# On Render: if using persistent disk, set to /var/data/models/weights
# If bundled in repo (not gitignored): leave as models/weights
MODEL_DIR=models/weights
MODEL_STATUS=TRAINED
DEMO_MODE=False

# ── File storage ────────────────────────────────────────────────
# On Render free tier, /tmp is writable but NOT persistent across restarts.
# For production persistence, use an external storage service (e.g. S3/Cloudflare R2).
# For now, /tmp works for demo/hackathon purposes.
UPLOAD_DIR=/tmp/drishti_uploads
REPORTS_DIR=/tmp/drishti_reports

# ── MATLAB ──────────────────────────────────────────────────────
# Not available on Render — Python fallback is used automatically.
MATLAB_AVAILABLE=False
MATLAB_ENGINE_PATH=
