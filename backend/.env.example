# DRISHTI-X Backend Environment Variables
# Copy this to .env and fill in your values

# Application
APP_ENV=development
DEBUG=True

# IMPORTANT: Change SECRET_KEY before any real deployment
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_REAL_SECRET_KEY_32_BYTES_HEX

# Database — update with your PostgreSQL credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://devanshjain06:yourpassword@localhost:5432/drishti_x

# Model
MODEL_DIR=models/weights
MODEL_STATUS=NOT_TRAINED
DEMO_MODE=True

# MATLAB (set True + path if MATLAB is installed)
MATLAB_AVAILABLE=False
MATLAB_ENGINE_PATH=

# File storage
UPLOAD_DIR=uploads
